008","tac:end":1173,"tac:exactQuote":"Review and verify sources and citations in GAI system outputs during pre-deployment risk measurement and ongoing monitoring activities.","tac:offsetUnit":"unicode_codepoints","tac:start":1038},{"@id":"urn:tacitus:nist-ai-600-1:statement:draft-citation-review:006acdb494cb87a3263daf40f6d5e550e28de039e6643ac707d51449d7f302ff","@type":["prov:Entity","tac:ProposedStatement"],"prov:wasDerivedFrom":{"@id":"urn:tacitus:nist-ai-600-1:span:draft-citation-review:c04ca66a2b3e59d0e18741185de67f805437b4950a479642b288cbe70c2675be"},"tac:interpretation":"The draft lists citation verification as action MS-2.5-008.","tac:modality":"suggested guidance","tac:practice":{"@id":"urn:tacitus:nist-ai-600-1:practice:citation-verification"},"tac:qualification":["pre-deployment risk measurement","ongoing monitoring activities"],"tac:reviewStatus":"proposed"},{"@id":"urn:tacitus:nist-ai-600-1:span:final-citation-review:e1b5e52f2bcf5cf29b745d842cdfc45499e35d2ba953ca52e2ef1c4cecdd43e4","@type":["prov:Entity","tac:EvidenceSpan"],"prov:wasDerivedFrom":{"@id":"urn:tacitus:nist-ai-600-1:edition:final:e1b5e52f2bcf5cf29b745d842cdfc45499e35d2ba953ca52e2ef1c4cecdd43e4"},"tac:actionId":"MS-2.5-003","tac:end":483,"tac:exactQuote":"Review and verify sources and citations in GAI system outputs during pre-deployment risk measurement and ongoing monitoring activities.","tac:offsetUnit":"unicode_codepoints","tac:start":348},{"@id":"urn:tacitus:nist-ai-600-1:statement:final-citation-review:6ba33abbd465f573556b6c029c30ee5346b5ff199580d63e41b47f0f3c4d1f73","@type":["prov:Entity","tac:ProposedStatement"],"prov:wasDerivedFrom":{"@id":"urn:tacitus:nist-ai-600-1:span:final-citation-review:e1b5e52f2bcf5cf29b745d842cdfc45499e35d2ba953ca52e2ef1c4cecdd43e4"},"tac:interpretation":"The final lists the same citation-verification wording as MS-2.5-003.","tac:modality":"suggested guidance","tac:practice":{"@id":"urn:tacitus:nist-ai-600-1:practice:citation-verification"},"tac:qualification"