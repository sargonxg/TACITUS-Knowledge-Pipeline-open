{"@context":{"@vocab":"https://tacitus.me/ns/reference#"},"@graph":[{"@id":"urn:tacitus:entity:ai-office","@type":"Institution","label":"AI Office"},{"@id":"urn:tacitus:entity:controller-assessment","@type":"Process","label":"Controller assessment process"},{"@id":"urn:tacitus:entity:dpia","@type":"Assessment","label":"Data-protection impact assessment"},{"@id":"urn:tacitus:entity:dpo","@type":"Reviewer","label":"Data protection officer where designated"},{"@id":"urn:tacitus:entity:fria","@type":"Assessment","label":"Fundamental-rights impact assessment"},{"@id":"urn:tacitus:source:b23997a5bebd23ef35688cc54414187770a7b293246e72eaed99110151bc5e6e","@type":"Source","label":"Article 27 · Fundamental rights impact assessment for high-risk AI systems","url":"https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng#art_27","version":"5086b303f88958eadcdb51769b4b3e48da35f3a44aaf9318ae41aed285fc6684"},{"@id":"urn:tacitus:source:da66e6de4d9ff6b402efeff382a6288797f61dc918aa1340232a1aca085cf4b6","@type":"Source","label":"Article 35 · Data protection impact assessment","url":"https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng#art_35","version":"611d22d9c72bbca3a140edb49e9338cd37b1bf3244f22eaff82e87ffc777df55"},{"@id":"urn:tacitus:statement:dpo-advice","@type":"Statement","cites":{"@id":"urn:tacitus:evidence:dpo-advice"},"label":"Preserve the DPO role and the designation condition.","modality":"obligation subject to designation","object":{"@id":"urn:tacitus:entity:dpo"},"predicate":"seeks_advice_from","qualifiedBy":{"@id":"urn:tacitus:qualification:dpo-advice:0"},"qualifiers_json":"[{\"end\":85,\"start\":69,\"text\":\"where designated\"}]","review_state":"proposed","subject":{"@id":"urn:tacitus:entity:controller-assessment"}},{"@id":"urn:tacitus:evidence:dpo-advice","@type":"EvidenceSpan","end":686,"fromSource":{"@id":"urn:tacitus:source:da66e6de4d9ff6b402efeff382a6288797f61dc918aa1340232a1aca085cf4b6"},"offset_unit":"unicode_codepoints","quote":"The controller shall seek the advice of the data protection officer, where designated, when carrying out a data protection impact assessment.","start":545},{"@id":"urn:tacitus:qualification:dpo-advice:0","@type":"Qualification","label":"where designated","review_state":"proposed","source_end":630,"source_start":614},{"@id":"urn:tacitus:statement:fria-complements-dpia","@type":"Statement","cites":{"@id":"urn:tacitus:evidence:fria-complements-dpia"},"label":"Map the conditional complement relationship; do not substitute one assessment for the other.","modality":"conditional obligation","object":{"@id":"urn:tacitus:entity:dpia"},"predicate":"conditionally_complements","qualifiedBy":{"@id":"urn:tacitus:qualification:fria-complements-dpia:0"},"qualifiers_json":"[{\"end\":214,\"start\":0,\"text\":\"If any of the obligations laid down in this Article is already met through the data protection impact assessment conducted pursuant to Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680\"}]","review_state":"proposed","subject":{"@id":"urn:tacitus:entity:fria"}},{"@id":"urn:tacitus:evidence:fria-complements-dpia","@type":"EvidenceSpan","end":2707,"fromSource":{"@id":"urn:tacitus:source:b23997a5bebd23ef35688cc54414187770a7b293246e72eaed99110151bc5e6e"},"offset_unit":"unicode_codepoints","quote":"If any of the obligations laid down in this Article is already met through the data protection impact assessment conducted pursuant to Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680, the fundamental rights impact assessment referred to in paragraph 1 of this Article shall complement that data protection impact assessment.","start":2351},{"@id":"urn:tacitus:qualification:fria-complements-dpia:0","@type":"Qualification","label":"If any of the obligations laid down in this Article is already met through the data protection impact assessment conducted pursuant to Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680","review_state":"proposed","source_end":2565,"source_start":2351},{"@id":"urn:tacitus:statement:office-template","@type":"Statement","cites":{"@id":"urn:tacitus:evidence:office-template"},"label":"The quoted template-development role does not identify the case reviewer.","modality":"stated institutional task","object":{"@id":"urn:tacitus:entity:fria"},"predicate":"develops_template_for","qualifiers_json":"[]","review_state":"proposed","subject":{"@id":"urn:tacitus:entity:ai-office"}},{"@id":"urn:tacitus:evidence:office-template","@type":"EvidenceSpan","end":2910,"fromSource":{"@id":"urn:tacitus:source:b23997a5bebd23ef35688cc54414187770a7b293246e72eaed99110151bc5e6e"},"offset_unit":"unicode_codepoints","quote":"5. The AI Office shall develop a template for a questionnaire, including through an automated tool, to facilitate deployers in complying with their obligations under this Article in a simplified manner.","start":2708}]}
