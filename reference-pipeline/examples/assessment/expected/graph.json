nstitution","label":"AI Office"},{"id":"entity:controller-assessment","kind":"Process","label":"Controller assessment process"},{"id":"entity:dpia","kind":"Assessment","label":"Data-protection impact assessment"},{"id":"entity:dpo","kind":"Reviewer","label":"Data protection officer where designated"},{"id":"entity:fria","kind":"Assessment","label":"Fundamental-rights impact assessment"},{"id":"source:b23997a5bebd23ef35688cc54414187770a7b293246e72eaed99110151bc5e6e","kind":"Source","label":"Article 27 · Fundamental rights impact assessment for high-risk AI systems","url":"https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng#art_27","version":"5086b303f88958eadcdb51769b4b3e48da35f3a44aaf9318ae41aed285fc6684"},{"id":"source:da66e6de4d9ff6b402efeff382a6288797f61dc918aa1340232a1aca085cf4b6","kind":"Source","label":"Article 35 · Data protection impact assessment","url":"https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng#art_35","version":"611d22d9c72bbca3a140edb49e9338cd37b1bf3244f22eaff82e87ffc777df55"},{"id":"statement:dpo-advice","kind":"Statement","label":"Preserve the DPO role and the designation condition.","modality":"obligation subject to designation","predicate":"seeks_advice_from","qualifiers":[{"end":85,"start":69,"text":"where designated"}],"review_state":"proposed"},{"end":686,"id":"evidence:dpo-advice","kind":"EvidenceSpan","offset_unit":"unicode_codepoints","quote":"The controller shall seek the advice of the data protection officer, where designated, when carrying out a data protection impact assessment.","start":545},{"id":"qualification:dpo-advice:0","kind":"Qualification","label":"where designated","review_state":"proposed","source_end":630,"source_start":614},{"id":"statement:fria-complements-dpia","kind":"Statement","label":"Map the conditional complement relationship; do not substitute one assessment for the other.","modality":"conditional obligation","predicate":"conditionally_complements","qualifiers":[{"end":214,"start":0,"text":"If any of the obligations laid down in this Article is already met through the data protection impact assessment conducted pursuant to Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680"}],"review_state":"proposed"},{"end":2707,"id":"evidence:fria-complements-dpia","kind":"EvidenceSpan","offset_unit":"unicode_codepoints","quote":"If any of the obligations laid down in this Article is already met through the data protection impact assessment conducted pursuant to Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680, the fundamental rights impact assessment referred to in paragraph 1 of this Article shall complement that data protection impact assessment.","start":2351},{"id":"qualification:fria-complements-dpia:0","kind":"Qualification","label":"If any of the obligations laid down in this Article is already met through the data protection impact assessment conducted pursuant to Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680","review_state":"proposed","source_end":2565,"source_start":2351},{"id":"statement:office-template","kind":"Statement","label":"The quoted template-development role does not identify the case reviewer.","modality":"stated institutional task","predicate":"develops_template_for","qualifiers":[],"review_state":"proposed"},{"end":2910,"id":"evidence:office-template","kind":"EvidenceSpan","offset_unit":"unicode_codepoints","quote":"5. The AI Office shall develop a template for a questionnaire, including through an automated tool, to facilitate deployers in complying with their obligations under this Article in a simplified manner.","start":2708}],"scope":"Source-backed authored mappings, not independently established case facts."}
